<Window x:Class="WpfApp2.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Учёт ТМЦ" Width="400" Height="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" Margin="40,0">
        <TextBlock Text="Вход в систему учёта ТМЦ" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
        <TextBlock Text="Логин"/>
        <TextBox x:Name="TbLogin" Margin="0,4,0,10" Padding="4"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PbPass" Margin="0,4,0,16" Padding="4"/>
        <Button Content="Войти" Click="BtnLogin_Click" Padding="0,8"/>
    </StackPanel>
</Window>